# Server only: copy this file to .env and set your own key. Never commit .env.
# Optional manual entry is also available in Settings > Model provider.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
FORGE_DATA_DIR=.data
WORKER_PORT=4318
# Set the official command from Studio > Assistant > Manage MCP Servers.
# Windows (recommended):
ROBLOX_MCP_COMMAND=cmd.exe
ROBLOX_MCP_ARGS=["/c","cd /d %LOCALAPPDATA%\\Roblox && .\\mcp.bat"]
# macOS: ROBLOX_MCP_COMMAND=/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP
# macOS: ROBLOX_MCP_ARGS=[]
# Optional secondary NVIDIA deployment, selected explicitly in Settings:
# NVIDIA_API_KEY=
# NVIDIA_TOKEN_ONLY=true
