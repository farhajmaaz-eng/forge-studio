# Recommended: enter your own key in Settings > Model provider.
# Environment configuration is optional for unattended installations.
MODEL_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_TOKEN_ONLY=true
FORGE_DATA_DIR=.data
WORKER_PORT=4318
# Copy command/args from Studio > Assistant > Manage MCP Servers.
# macOS example:
ROBLOX_MCP_COMMAND=/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP
ROBLOX_MCP_ARGS=[]
# Windows: command=cmd.exe, args=["/c","C:\\Users\\YOU\\AppData\\Local\\Roblox\\mcp.bat"]
